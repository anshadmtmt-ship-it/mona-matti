pipeline {
    agent any

    parameters {
        string(
            name: 'CI_BUILD_NUMBER',
            defaultValue: '',
            description: 'Enter CI Build Number (Example: 38)'
        )
    }

    environment {
        S3_BUCKET = "mona-matti-kustomize-artifacts"
        KUBECONFIG = "/var/lib/jenkins/.kube/config"
    }

    stages {

        stage('Debug') {
            steps {
                script {
                    echo "CI_BUILD_NUMBER = '${params.CI_BUILD_NUMBER}'"

                    if (!params.CI_BUILD_NUMBER?.trim()) {
                        error("CI_BUILD_NUMBER parameter is empty!")
                    }
                }
            }
        }

        stage('Download Kustomize Artifact') {
            steps {
                script {
                    def artifact = "kustomize-${params.CI_BUILD_NUMBER}.tar.gz"

                    echo "Downloading ${artifact}"

                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'aws-creds']
                    ]) {
                        sh """
                            rm -rf kustomize
                            rm -f kustomize-*.tar.gz

                            aws s3 cp s3://${S3_BUCKET}/${artifact} .
                        """
                    }
                }
            }
        }

        stage('Extract Artifact') {
            steps {
                script {
                    def artifact = "kustomize-${params.CI_BUILD_NUMBER}.tar.gz"

                    sh """
                        tar -xzf ${artifact}
                    """
                }
            }
        }

        stage('Deploy to Dev') {
            steps {
                sh """
                    export KUBECONFIG=${KUBECONFIG}
                    kubectl apply -k kustomize/overlays/dev
                """
            }
        }

        stage('Verify Rollout') {
            steps {
                sh """
                    export KUBECONFIG=${KUBECONFIG}
                    kubectl rollout status deployment/mona-matti -n dev
                """
            }
        }
    }

    post {
        success {
            echo "Deployment Successful"
        }

        failure {
            echo "Deployment Failed"
        }

        always {
            cleanWs()
        }
    }
}