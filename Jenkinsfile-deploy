pipeline {
    agent any

    parameters {
        string(
            name: 'CI_BUILD_NUMBER',
            defaultValue: '',
            description: 'Enter CI Build Number (Example: 43)'
        )
    }

    environment {
        S3_BUCKET = "mona-matti-kustomize-artifacts"
        KUBECONFIG = "/var/lib/jenkins/.kube/config"
    }

    stages {

        stage('Download Kustomize Artifact') {
            steps {
                script {
                    if (!params.CI_BUILD_NUMBER?.trim()) {
                        error("CI_BUILD_NUMBER cannot be empty.")
                    }

                    def artifact = "kustomize-${params.CI_BUILD_NUMBER}.tar.gz"

                    echo "Downloading ${artifact}"

                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'aws-creds']
                    ]) {
                        sh """
                            rm -rf deploy
                            rm -f kustomize-*.tar.gz

                            mkdir deploy

                            aws s3 cp \
                            s3://${S3_BUCKET}/${artifact} \
                            .
                        """
                    }
                }
            }
        }

        stage('Extract Artifact') {
            steps {
                sh """
                    tar -xzf kustomize-${params.CI_BUILD_NUMBER}.tar.gz -C deploy
                """
            }
        }

        stage('Verify Artifact') {
            steps {
                sh """
                    echo "=================================="
                    echo "Kustomization File"
                    echo "=================================="
                    cat deploy/kustomize/overlays/production/kustomization.yaml

                    echo
                    echo "=================================="
                    echo "Rendered Image"
                    echo "=================================="
                    kubectl kustomize deploy/kustomize/overlays/production | grep image:
                """
            }
        }

        stage('Deploy to Production') {
            steps {
                sh """
                    export KUBECONFIG=${KUBECONFIG}

                    kubectl apply \
                    -k deploy/kustomize/overlays/production
                """
            }
        }

        stage('Verify Rollout') {
            steps {
                sh """
                    export KUBECONFIG=${KUBECONFIG}

                    kubectl rollout status deployment/mona-matti -n production
                """
            }
        }

    }

    post {

        success {
            echo "========================================"
            echo "Deployment Successful"
            echo "Environment : production"
            echo "Build Number: ${params.CI_BUILD_NUMBER}"
            echo "========================================"
        }

        failure {
            echo "Deployment Failed"
        }

        always {
            cleanWs()
        }
    }
}