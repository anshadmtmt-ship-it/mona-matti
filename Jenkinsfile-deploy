pipeline {
    agent any

    parameters {
        string(
            name: 'IMAGE_TAG',
            defaultValue: '',
            description: 'Docker image tag. Example: 60'
        )
    }

    environment {
        DOCKER_IMAGE = 'anshadin4k/mona-matti'
        HELM_REPO    = 'oci://registry-1.docker.io/anshadin4k'
        ARGOCD_APP   = 'mona-matti'
    }

    stages {

        stage('Validate') {
            steps {
                script {
                    if (!params.IMAGE_TAG?.trim()) {
                        error('IMAGE_TAG cannot be empty')
                    }

                    echo "Image: ${DOCKER_IMAGE}:${IMAGE_TAG}"
                }
            }
        }

        stage('Prepare Helm') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {
                    sh '''
                        set -e

                        rm -rf deploy package
                        mkdir -p deploy package

                        echo "$DOCKER_PASS" | helm registry login \
                            registry-1.docker.io \
                            --username "$DOCKER_USER" \
                            --password-stdin

                        echo "Checking Docker image..."
                        docker manifest inspect \
                            ${DOCKER_IMAGE}:${IMAGE_TAG} > /dev/null

                        echo "Getting latest Helm chart version..."
                        CURRENT_CHART=$(helm show chart \
                            ${HELM_REPO}/mona-matti 2>/dev/null |
                            awk '$1=="version:" {print $2}')

                        echo "Current chart: ${CURRENT_CHART}"

                        MAJOR=$(echo ${CURRENT_CHART} | cut -d. -f1)
                        MINOR=$(echo ${CURRENT_CHART} | cut -d. -f2)
                        PATCH=$(echo ${CURRENT_CHART} | cut -d. -f3)

                        CHART_VERSION="${MAJOR}.${MINOR}.$((PATCH + 1))"

                        echo "New chart: ${CHART_VERSION}"

                        echo "${CHART_VERSION}" > chart-version.txt

                        echo "Pulling Helm chart..."

                        helm pull \
                            ${HELM_REPO}/mona-matti \
                            --version ${CURRENT_CHART} \
                            --untar \
                            --untardir deploy

                        cd deploy/mona-matti

                        echo "Updating chart..."

                        sed -i \
                            "s/^version:.*/version: ${CHART_VERSION}/" \
                            Chart.yaml

                        sed -i \
                            "s/^appVersion:.*/appVersion: \\"${IMAGE_TAG}\\"/" \
                            Chart.yaml

                        sed -i \
                            "s/^  tag:.*/  tag: \\"${IMAGE_TAG}\\"/" \
                            values.yaml

                        echo "Chart version:"
                        grep '^version:' Chart.yaml

                        echo "App version:"
                        grep '^appVersion:' Chart.yaml

                        echo "Image:"
                        grep -A3 '^image:' values.yaml

                        echo "Linting..."
                        helm lint .

                        echo "Packaging..."
                        helm package . \
                            --destination ../../package
                    '''
                }
            }
        }

        stage('Push Helm Chart') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {
                    sh '''
                        set -e

                        echo "$DOCKER_PASS" | helm registry login \
                            registry-1.docker.io \
                            --username "$DOCKER_USER" \
                            --password-stdin

                        CHART_VERSION=$(cat chart-version.txt)

                        echo "Pushing Helm chart ${CHART_VERSION}..."

                        helm push \
                            package/mona-matti-${CHART_VERSION}.tgz \
                            ${HELM_REPO}
                    '''
                }
            }
        }

        stage('Deploy with ArgoCD') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'argocd-token',
                        variable: 'ARGOCD_AUTH_TOKEN'
                    )
                ]) {
                    withKubeConfig(
                        credentialsId: 'kubeconfig-prod'
                    ) {
                        sh '''
                            set -e

                            CHART_VERSION=$(cat chart-version.txt)

                            echo "Deploying chart ${CHART_VERSION}..."

                            argocd app sync ${ARGOCD_APP} \
                                --revision ${CHART_VERSION} \
                                --auth-token "$ARGOCD_AUTH_TOKEN" \
                                --insecure \
                                --port-forward \
                                --port-forward-namespace argocd

                            echo "Waiting for ArgoCD sync..."

                            argocd app wait ${ARGOCD_APP} \
                                --auth-token "$ARGOCD_AUTH_TOKEN" \
                                --insecure \
                                --port-forward \
                                --port-forward-namespace argocd \
                                --sync \
                                --timeout 180
                        '''
                    }
                }
            }
        }

        stage('Verify Rollout') {
            steps {
                withKubeConfig(
                    credentialsId: 'kubeconfig-prod'
                ) {
                    sh '''
                        echo "Rollout status:"
                        kubectl argo rollouts get rollout \
                            mona-matti \
                            -n production

                        echo "Pods:"
                        kubectl get pods -n production

                        echo "Services:"
                        kubectl get svc \
                            mona-matti-stable \
                            mona-matti-canary \
                            -n production
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "Deployment completed for image ${DOCKER_IMAGE}:${IMAGE_TAG}"
        }

        failure {
            echo "Deployment failed"
        }

        always {
            sh 'helm registry logout registry-1.docker.io || true'
            cleanWs()
        }
    }
}