pipeline {
    agent any

    parameters {
        string(
            name: 'IMAGE_TAG',
            defaultValue: '',
            description: 'Docker image tag from CI. Example: 57'
        )
    }

    environment {
        DOCKER_IMAGE = 'anshadin4k/mona-matti'
        HELM_REPO    = 'oci://registry-1.docker.io/anshadin4k'
        ARGOCD_APP   = 'mona-matti'
    }

    stages {

        stage('Validate') {
            steps {
                script {
                    if (!params.IMAGE_TAG?.trim()) {
                        error('IMAGE_TAG cannot be empty')
                    }

                    echo "Image: ${DOCKER_IMAGE}:${IMAGE_TAG}"
                    echo "Chart: 1.0.${IMAGE_TAG}"
                }
            }
        }

        stage('Prepare Helm') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {
                    sh '''
                        rm -rf deploy package
                        mkdir -p deploy package

                        echo "$DOCKER_PASS" | helm registry login \
                            registry-1.docker.io \
                            -u "$DOCKER_USER" \
                            --password-stdin

                        docker manifest inspect \
                            ${DOCKER_IMAGE}:${IMAGE_TAG} > /dev/null

                        helm pull \
                            ${HELM_REPO}/mona-matti \
                            --untar \
                            --untardir deploy

                        cd deploy/mona-matti

                        sed -i "s/^version:.*/version: 1.0.${IMAGE_TAG}/" Chart.yaml
                        sed -i "s/^appVersion:.*/appVersion: \\"${IMAGE_TAG}\\"/" Chart.yaml
                        sed -i "s/^  tag:.*/  tag: \\"${IMAGE_TAG}\\"/" values.yaml

                        helm lint .

                        helm package . \
                            --destination ../../package
                    '''
                }
            }
        }

        stage('Push Helm Chart') {
            steps {
                sh '''
                    helm push \
                        package/mona-matti-1.0.${IMAGE_TAG}.tgz \
                        ${HELM_REPO}
                '''
            }
        }

        stage('Deploy with ArgoCD') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'argocd-token',
                        variable: 'ARGOCD_AUTH_TOKEN'
                    )
                ]) {
                    withKubeConfig(
                        credentialsId: 'kubeconfig-prod'
                    ) {
                        sh '''
                            argocd app sync ${ARGOCD_APP} \
                                --revision 1.0.${IMAGE_TAG} \
                                --auth-token "$ARGOCD_AUTH_TOKEN" \
                                --insecure \
                                --port-forward \
                                --port-forward-namespace argocd

                            argocd app wait ${ARGOCD_APP} \
                                --auth-token "$ARGOCD_AUTH_TOKEN" \
                                --insecure \
                                --port-forward \
                                --port-forward-namespace argocd \
                                --sync \
                                --health \
                                --timeout 300
                        '''
                    }
                }
            }
        }

        stage('Verify') {
            steps {
                withKubeConfig(
                    credentialsId: 'kubeconfig-prod'
                ) {
                    sh '''
                        kubectl rollout status \
                            deployment/mona-matti \
                            -n production

                        echo "Running image:"
                        kubectl get deployment mona-matti \
                            -n production \
                            -o jsonpath='{.spec.template.spec.containers[0].image}'

                        echo
                        kubectl get pods -n production
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "Deployment successful: ${DOCKER_IMAGE}:${IMAGE_TAG}"
        }

        failure {
            echo "Deployment failed"
        }

        always {
            helm registry logout registry-1.docker.io || true
            cleanWs()
        }
    }
}