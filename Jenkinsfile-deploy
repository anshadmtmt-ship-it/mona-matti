pipeline {
    agent any

    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'production'],
            description: 'Select deployment environment'
        )

        string(
            name: 'CI_BUILD_NUMBER',
            defaultValue: '',
            description: 'Enter the CI build number (Example: 38)'
        )
    }

    environment {
        AWS_REGION = "eu-north-1"
        S3_BUCKET  = "mona-matti-kustomize-artifacts"
        KUBECONFIG = "/var/lib/jenkins/.kube/config"
    }

    stages {

        stage('Download Kustomize Artifact') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-creds']
                ]) {

                    sh """
                        rm -rf kustomize
                        rm -f kustomize-*.tar.gz

                        aws s3 cp \
                        s3://${S3_BUCKET}/kustomize-${params.CI_BUILD_NUMBER}.tar.gz \
                        .
                    """
                }
            }
        }

        stage('Extract Artifact') {
            steps {
                sh """
                    tar -xzf kustomize-${params.CI_BUILD_NUMBER}.tar.gz
                """
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                sh """
                    export KUBECONFIG=${KUBECONFIG}

                    kubectl apply \
                    -k kustomize/overlays/${params.ENVIRONMENT}
                """
            }
        }

        stage('Verify Rollout') {
            steps {
                sh """
                    export KUBECONFIG=${KUBECONFIG}

                    kubectl rollout status deployment/mona-matti \
                    -n ${params.ENVIRONMENT}
                """
            }
        }

    }

    post {

        success {
            echo "====================================="
            echo "Deployment Successful"
            echo "Environment : ${params.ENVIRONMENT}"
            echo "CI Build : ${params.CI_BUILD_NUMBER}"
            echo "====================================="
        }

        failure {
            echo "Deployment Failed"
        }

        always {
            cleanWs()
        }
    }
}