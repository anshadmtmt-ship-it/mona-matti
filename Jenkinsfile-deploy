pipeline {
    agent any

    parameters {
        string(
            name: 'CI_BUILD_NUMBER',
            defaultValue: '',
            description: 'Enter CI Build Number (Example: 38)'
        )
    }

    environment {
        S3_BUCKET = "mona-matti-kustomize-artifacts"
        KUBECONFIG = "/var/lib/jenkins/.kube/config"
    }

    stages {

        stage('Download Kustomize Artifact') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-creds']
                ]) {
                    sh """
                        rm -rf kustomize
                        rm -f kustomize-*.tar.gz

                        aws s3 cp \
                        s3://${S3_BUCKET}/kustomize-${params.CI_BUILD_NUMBER}.tar.gz .
                    """
                }
            }
        }

        stage('Extract Artifact') {
            steps {
                sh """
                    tar -xzf kustomize-${params.CI_BUILD_NUMBER}.tar.gz
                """
            }
        }

        stage('Deploy to Dev') {
            steps {
                sh """
                    export KUBECONFIG=${KUBECONFIG}

                    kubectl apply -k kustomize/overlays/dev
                """
            }
        }

        stage('Verify Rollout') {
            steps {
                sh """
                    export KUBECONFIG=${KUBECONFIG}

                    kubectl rollout status deployment/mona-matti -n dev
                """
            }
        }
    }

    post {
        success {
            echo "====================================="
            echo "Deployment Successful"
            echo "CI Build : ${params.CI_BUILD_NUMBER}"
            echo "Environment : dev"
            echo "====================================="
        }

        failure {
            echo "Deployment Failed"
        }

        always {
            cleanWs()
        }
    }
}